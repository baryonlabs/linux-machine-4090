## labops — static audit rules (installed to /etc/audit/rules.d/50-labops.rules).
## Generated companions (by `labctl sync` / `labctl audit-rules`):
##   51-labops-students.rules  execve per student loginuid      (key student_exec)
##   52-labops-setuid.rules    exec of every setuid/setgid file  (key setuid_exec)
## Ubuntu's 10-base / audit.rules supplies -D, -b and -f. No -e 2 (immutable) so labctl can reload rules.
## Privacy: no pam_tty_audit / TTY or keystroke recording anywhere.

## Buffer sized for execve bursts (pip/conda spawn many processes)
-b 16384
--backlog_wait_time 60000

## --- privilege escalation attempts (before the setuid list: first matching rule wins)
-a always,exit -F path=/usr/bin/sudo -F perm=x -F auid>=1000 -F auid!=unset -k priv_esc
-a always,exit -F path=/usr/bin/su -F perm=x -F auid>=1000 -F auid!=unset -k priv_esc
-a always,exit -F path=/usr/bin/pkexec -F perm=x -F auid>=1000 -F auid!=unset -k priv_esc

## --- identity / sudo / ssh / audit / labops configuration writes
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config
-w /etc/audit/ -p wa -k audit_config
-w /etc/labops/ -p wa -k labops_config

## --- reads of /etc/shadow by non-root logged-in users (root sshd/PAM helpers retain the session auid)
-a always,exit -F arch=b64 -S open,openat,openat2 -F path=/etc/shadow -F auid>=1000 -F auid!=unset -F uid>=1000 -k shadow_read
-a always,exit -F arch=b32 -S open,openat -F path=/etc/shadow -F auid>=1000 -F auid!=unset -F uid>=1000 -k shadow_read

## --- CVE-2026-98432: setsockopt(fd, IPPROTO_IP=0, IP_OPTIONS=4, ...) — any user, success or not
-a always,exit -F arch=b64 -S setsockopt -F a1=0 -F a2=4 -k cve_2026_98432
-a always,exit -F arch=b32 -S setsockopt -F a1=0 -F a2=4 -k cve_2026_98432

## --- ptrace attach / seize / poke by logged-in users
-a always,exit -F arch=b64 -S ptrace -F a0=0x10 -F auid>=1000 -F auid!=unset -k ptrace
-a always,exit -F arch=b64 -S ptrace -F a0=0x4206 -F auid>=1000 -F auid!=unset -k ptrace
-a always,exit -F arch=b64 -S ptrace -F a0=0x4 -F auid>=1000 -F auid!=unset -k ptrace
-a always,exit -F arch=b64 -S ptrace -F a0=0x5 -F auid>=1000 -F auid!=unset -k ptrace

## --- kernel modules loaded/unloaded from a login session (kernel auto-load / boot has auid unset)
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k modules

## --- labops privileged-request queue
-w /var/lib/labops/decisions/ -p wa -k labops_decision
-w /opt/labops/bin/labops-executor -p x -k labops_executor
