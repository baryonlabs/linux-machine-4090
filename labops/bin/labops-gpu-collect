#!/usr/bin/env python3
"""GPU usage collector (systemd timer, every minute).

nvidia-smi --query-compute-apps → PID → uid/user/cmd/start time (from /proc) → SQLite.
  --print   query + map and print, do not write (safe as any user)
  --db PATH override database (default from labops.conf GPU_DB)
"""
import argparse
import os
import sqlite3
import subprocess
import sys
import time

for _p in ("/opt/labops/lib", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib")):
    if os.path.isdir(_p):
        sys.path.insert(0, _p)
import labops_common as C  # noqa: E402

RETENTION_DAYS = 400
SCHEMA = """
CREATE TABLE IF NOT EXISTS samples(ts INTEGER NOT NULL, pid INTEGER, start_ts INTEGER, uid INTEGER, user TEXT,
                                   cmd TEXT, vram_mib INTEGER, gpu_uuid TEXT);
CREATE INDEX IF NOT EXISTS samples_ts ON samples(ts);
CREATE INDEX IF NOT EXISTS samples_user_ts ON samples(user, ts);
CREATE TABLE IF NOT EXISTS gpu(ts INTEGER NOT NULL, gpu_uuid TEXT, util INTEGER, mem_used INTEGER, mem_total INTEGER,
                               temp INTEGER, power REAL);
CREATE INDEX IF NOT EXISTS gpu_ts ON gpu(ts);
"""


def smi(query, kind):
    r = subprocess.run(["nvidia-smi", f"--query-{kind}={query}", "--format=csv,noheader,nounits"],
                       capture_output=True, text=True, timeout=30, env={**os.environ, "LC_ALL": "C"})
    if r.returncode != 0:
        raise RuntimeError(f"nvidia-smi failed: {r.stderr.strip() or r.stdout.strip()}")
    rows = []
    for ln in r.stdout.splitlines():
        if ln.strip() and "No running" not in ln:
            rows.append([c.strip() for c in ln.split(",")])
    return rows


def _num(v, cast=int):
    try:
        return cast(float(v))
    except (TypeError, ValueError):
        return None


_BTIME = None
_HZ = os.sysconf("SC_CLK_TCK")


def proc_info(pid):
    global _BTIME
    if _BTIME is None:
        with open("/proc/stat") as f:
            _BTIME = next(int(ln.split()[1]) for ln in f if ln.startswith("btime"))
    info = {"uid": None, "user": "?", "cmd": "?", "start_ts": None}
    try:
        info["uid"] = os.stat(f"/proc/{pid}").st_uid
        info["user"] = C.uid_name(info["uid"])
    except OSError:
        return info
    try:
        with open(f"/proc/{pid}/stat") as f:
            st = f.read()
        fields = st[st.rindex(")") + 2:].split()
        info["start_ts"] = int(_BTIME + int(fields[19]) / _HZ)
    except (OSError, ValueError, IndexError):
        pass
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            cmd = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
        info["cmd"] = C.sanitize_text(cmd, 200) or "?"
    except OSError:
        pass
    return info


def collect():
    now = int(time.time())
    apps = []
    for pid, pname, mem, uuid in smi("pid,process_name,used_memory,gpu_uuid", "compute-apps"):
        pid = _num(pid)
        if pid is None:
            continue
        pi = proc_info(pid)
        if pi["cmd"] == "?":
            pi["cmd"] = pname
        apps.append((now, pid, pi["start_ts"], pi["uid"], pi["user"], pi["cmd"], _num(mem), uuid))
    gpus = []
    for uuid, util, used, total, temp, power in smi("uuid,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw", "gpu"):
        gpus.append((now, uuid, _num(util), _num(used), _num(total), _num(temp), _num(power, float)))
    return apps, gpus


def gpu_alerts(conf, apps, gpus):
    """Edge-triggered Discord alerts: util >= HIGH for N samples -> busy; then 0% for M samples -> idle."""
    import json
    hi = int(conf.get("GPU_ALERT_HIGH_PCT", "50"))
    n_hi = int(conf.get("GPU_ALERT_HIGH_SAMPLES", "2"))
    n_idle = int(conf.get("GPU_ALERT_IDLE_SAMPLES", "3"))
    path = conf.get("GPU_ALERT_STATE", "/var/lib/labops/gpu-alert.json")
    try:
        st = json.load(open(path))
    except (OSError, ValueError):
        st = {}
    users = sorted({f"{a[4]}" for a in apps}) or ["(no compute process)"]
    jobs = "\n".join(f"  · `{a[4]}` pid {a[1]} · {a[6] or 0} MiB · `{(a[5] or '')[:70]}`" for a in apps[:6])
    changed = False
    for g in gpus:
        uuid, util, used, total = g[1], g[2] or 0, g[3] or 0, g[4] or 0
        s = st.get(uuid, {"busy": False, "hi": 0, "zero": 0})
        s["hi"] = s["hi"] + 1 if util >= hi else 0
        s["zero"] = s["zero"] + 1 if util == 0 else 0
        if s["busy"]:
            s["peak_util"] = max(s.get("peak_util", 0), util)
            s["peak_mem"] = max(s.get("peak_mem", 0), used)
            s["users"] = sorted(set(s.get("users", [])) | {a[4] for a in apps})
        if not s["busy"] and s["hi"] >= n_hi:
            s.update(busy=True, since=g[0], peak_util=util, peak_mem=used, users=[a[4] for a in apps])
            C.discord_post(f"🔥 **GPU busy** util {util}% (≥{hi}% for {n_hi} min) · VRAM {used}/{total} MiB · users: {', '.join(users)}"
                           + (f"\n{jobs}" if apps else ""))
            changed = True
        elif s["busy"] and s["zero"] >= n_idle:
            dur = (g[0] - s.get("since", g[0])) // 60
            C.discord_post(f"💤 **GPU idle** util 0% for {n_idle} min · busy period {dur // 60}h {dur % 60}m · "
                           f"peak {s.get('peak_util', 0)}% / {s.get('peak_mem', 0)} MiB · users: {', '.join(s.get('users') or ['?'])}")
            s = {"busy": False, "hi": 0, "zero": s["zero"]}
            changed = True
        st[uuid] = s
    C.atomic_write(path, json.dumps(st), mode=0o640)
    return changed


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--print", action="store_true", help="print, do not write")
    ap.add_argument("--db")
    a = ap.parse_args()
    conf = C.load_conf()
    apps, gpus = collect()
    if a.print:
        for g in gpus:
            print(f"GPU {g[1]}: util {g[2]}%  mem {g[3]}/{g[4]} MiB  {g[5]}C  {g[6]}W")
        for s in apps:
            age = f"{(s[0]-s[2])/3600:.1f}h" if s[2] else "?"
            print(f"  pid {s[1]:<8} user {s[4]:<14} vram {s[6]} MiB  running {age:<7} {s[5][:80]}")
        if not apps:
            print("  (no compute processes)")
        return
    db = a.db or conf["GPU_DB"]
    os.makedirs(os.path.dirname(db), exist_ok=True)
    con = sqlite3.connect(db, timeout=30)
    con.executescript(SCHEMA)
    with con:
        con.executemany("INSERT INTO samples VALUES (?,?,?,?,?,?,?,?)", apps)
        con.executemany("INSERT INTO gpu VALUES (?,?,?,?,?,?,?)", gpus)
        if time.localtime().tm_min == 0:  # hourly housekeeping
            cut = int(time.time()) - RETENTION_DAYS * 86400
            con.execute("DELETE FROM samples WHERE ts < ?", (cut,))
            con.execute("DELETE FROM gpu WHERE ts < ?", (cut,))
    con.close()
    try:
        gpu_alerts(conf, apps, gpus)
    except Exception as e:  # alerts must never break sampling
        C.log(f"gpu_alerts: {e}", err=True)


if __name__ == "__main__":
    main()
