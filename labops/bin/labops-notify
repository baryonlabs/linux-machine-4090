#!/usr/bin/env python3
"""Post a message to the labops Discord webhook.  Usage: labops-notify "text"   or   echo text | labops-notify -"""
import os
import sys

for _p in ("/opt/labops/lib", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib")):
    if os.path.isdir(_p):
        sys.path.insert(0, _p)
import labops_common as C  # noqa: E402

if len(sys.argv) < 2:
    sys.exit(__doc__)
text = sys.stdin.read() if sys.argv[1] == "-" else " ".join(sys.argv[1:])
sys.exit(0 if C.discord_post(text) else 1)
