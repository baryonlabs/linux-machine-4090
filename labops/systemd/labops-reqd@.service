[Unit]
Description=labops request handler (caller identity from SO_PEERCRED)

[Service]
User=labops
Group=labops
ExecStart=/usr/bin/python3 -I /opt/labops/bin/labops-reqd
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30
MemoryMax=64M
TasksMax=8
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/labops/requests /var/log/labops/requests.log
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
